{
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@commitlint/config-pnpm-scopes": "^21.2.2",
		"@commitlint/types": "^21.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1"
	},
	"scripts": {
		"prepare": "husky"
	},
	"lint-staged": {
		"backend/**/*.py": [
			"ruff check --fix",
			"ruff format"
		],
		"frontend/**/*.{js,jsx,ts,tsx,json,css}": [
			"biome check --write"
		]
	}
}